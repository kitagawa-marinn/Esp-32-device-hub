PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Frontend URL untuk CORS
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Database (optional)
MONGODB_URI=mongodb://localhost:27017/esp32-hub

# mDNS Discovery
MDNS_DOMAIN=local
DISCOVERY_INTERVAL=30000

# Logging
LOG_LEVEL=info
